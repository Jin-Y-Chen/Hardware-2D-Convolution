mac_pipe       rtl/params.sv rtl/part1/mac_pipe.sv
mac_tb         rtl/params.sv rtl/part1/mac.sv rtl/part1/mac_pipe.sv tb/part1/mac_tb.sv tb/part1/mac_tb.c
input_mems     rtl/params.sv rtl/part2/input_mems.sv
input_mems_tb  rtl/params.sv rtl/part2/input_mems.sv tb/part2/input_mems_tb.sv
control        rtl/params.sv rtl/part3/control.sv

Conv           rtl/params.sv rtl/part3/fifo_out.sv rtl/part2/input_mems.sv rtl/part1/mac_pipe.sv rtl/part3/control.sv rtl/part3/Conv.sv
