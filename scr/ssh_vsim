#!/usr/bin/env bash
# vsim <testbench> <dut> — compile, then simulate in the console.

set -euo pipefail
# shellcheck source=libaray/cad_common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/libaray/cad_common.sh"

usage() {
    cat <<'EOF'
vsim <testbench> <dut>

  vsim mac_tb mac
  vsim mac_tb_mod mac_pipe
  vsim --seed 1896683400 mac_tb mac

  -h, --help     this text
  -s, --seed N   one run (default: sim.seed)
EOF
}

hint() { echo "$1" >&2; exit 2; }

TOP="" DUT="" SEED="" SEED_SET=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -s|--seed) [[ $# -ge 2 ]] || hint "vsim --seed <N> <testbench> <dut>"; SEED="$2"; SEED_SET=1; shift 2 ;;
        -*) hint "vsim <testbench> <dut>" ;;
        *)
            if [[ -z "$TOP" ]]; then TOP="$1"
            elif [[ -z "$DUT" ]]; then DUT="$1"
            else hint "vsim <testbench> <dut>"
            fi
            shift ;;
    esac
done

apply_config
[[ "$SEED_SET" -eq 0 ]] && SEED="$CFG_SEED"
[[ -n "$TOP" && -n "$DUT" ]] || hint "vsim mac_tb mac"
TB_FILE="$(locate_src "$TOP")"
DUT_FILE="$(locate_src "$DUT")"
DUT="$(basename "$DUT_FILE" .sv)"
# mac is the combinational DUT (PIPELINED 0); mac_pipe is the pipelined one (PIPELINED 1).
case "$DUT" in
    mac)      [[ "$P_PIPE" == 0 ]] || hint "Set design.PIPELINED to 0 in constraint/all_config.json for mac." ;;
    mac_pipe) [[ "$P_PIPE" == 1 ]] || hint "Set design.PIPELINED to 1 in constraint/all_config.json for mac_pipe." ;;
esac

files=("$DUT_FILE" "$TB_FILE")
[[ -f "$LOCAL_TB/part1/${TOP}.c" ]] && files+=("tb/part1/${TOP}.c")
cad_vlog "${files[@]}"   # same compile as vlog, then simulate

echo "vsim  $TOP  $DUT  seed=$SEED"
set +e
remote_py vsim --proj "$REMOTE_PROJECT_REL" --top "$TOP" --seed "$SEED" --pipelined "$P_PIPE"
rc=$?
set -e
mkdir -p "$LOCAL_LOG"
rsync_from_remote "~/$REMOTE_LOG_REL/vsim.log" "$LOCAL_LOG/vsim.log" || true
exit "$rc"
