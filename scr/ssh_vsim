#!/usr/bin/env bash
# vsim [TOP] [DUT] — compile, then simulate in the console.

set -euo pipefail
# shellcheck source=libaray/cad_common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/libaray/cad_common.sh"

usage() {
    cat <<'EOF'
vsim [TOP] [DUT]

  vsim --seed N [TOP] [DUT]

  [TOP] is the testbench. [DUT] is the design.
  When [DUT] is input_mems, WIDTH, R, C, and K come from rtl/param.sv.
  TVALID_PROB and STAGE come from sim in constraint/all_config.json.

  -h, --help     this text
  -s, --seed N   one run (default: sim.seed)
EOF
}

TOP="" DUT="" SEED="" SEED_SET=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -s|--seed) [[ $# -ge 2 ]] || { usage >&2; exit 2; }; SEED="$2"; SEED_SET=1; shift 2 ;;
        -*) usage >&2; exit 2 ;;
        *)
            if [[ -z "$TOP" ]]; then TOP="$1"
            elif [[ -z "$DUT" ]]; then DUT="$1"
            else usage >&2; exit 2
            fi
            shift ;;
    esac
done

apply_config
[[ "$SEED_SET" -eq 0 ]] && SEED="$CFG_SEED"
[[ -n "$TOP" && -n "$DUT" ]] || { usage >&2; exit 2; }
TB_FILE="$(locate_src "$TOP")"
DUT_FILE="$(locate_src "$DUT")"
# vsim loads a module name. input_mems_tb.sv is library "input_mems_tb", design "sv".
TOP="$(basename "$TB_FILE" .sv)"
DUT="$(basename "$DUT_FILE" .sv)"
# mac is the combinational DUT (PIPELINED 0); mac_pipe is the pipelined one (PIPELINED 1).
# input_mems reads rtl/param.sv for WIDTH, R, C, K.
# sim.TVALID_PROB and sim.STAGE override the testbench parameters.
vsim_args=(vsim --proj "$REMOTE_PROJECT_REL" --top "$TOP" --seed "$SEED")
case "$DUT" in
    mac)
        [[ "$P_PIPE" == 0 ]] || { echo "Set design.PIPELINED to 0 in constraint/all_config.json for mac." >&2; exit 2; }
        vsim_args+=(--pipelined "$P_PIPE")
        ;;
    mac_pipe)
        [[ "$P_PIPE" == 1 ]] || { echo "Set design.PIPELINED to 1 in constraint/all_config.json for mac_pipe." >&2; exit 2; }
        vsim_args+=(--pipelined "$P_PIPE")
        ;;
    input_mems)
        check_input_mems || exit $?
        vsim_args+=(--stage "$P_STAGE" --tvalid "$P_TVPR")
        ;;
esac

files=("$DUT_FILE" "$TB_FILE")
[[ -f "$LOCAL_TB/part1/${TOP}.c" ]] && files+=("tb/part1/${TOP}.c")
cad_vlog "${files[@]}"   # same compile as vlog, then simulate

if [[ "$DUT" == input_mems ]]; then
    echo "vsim  $TOP  $DUT  seed=$SEED  WIDTH=$P_WIDTH R=$P_R C=$P_C K=$P_K TVALID_PROB=$P_TVPR STAGE=$P_STAGE"
else
    echo "vsim  $TOP  $DUT  seed=$SEED"
fi
set +e
remote_py "${vsim_args[@]}"
rc=$?
set -e
mkdir -p "$LOCAL_LOG"
rsync_from_remote "~/$REMOTE_LOG_REL/vsim.log" "$LOCAL_LOG/vsim.log" || true
exit "$rc"
