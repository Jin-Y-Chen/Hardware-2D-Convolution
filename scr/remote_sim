#!/usr/bin/env bash
# Compile (and simulate, if a TB is present) the Part 1 MAC on eceap1.
# Usage:  sim     or    ./scr/remote_sim
# Copies the vlog transcript to sim/part1/vlog.log — look for "Errors: 0".

set -euo pipefail

REMOTE_USER="jinchen"
REMOTE_HOST="eceap1.ece.stonybrook.edu"
REMOTE_PROJECT="~/ese507/project"

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCAL_LOG_DIR="$PROJECT_ROOT/sim/part1"

mkdir -p "$LOCAL_LOG_DIR"

REMOTE_RTL="$REMOTE_PROJECT/rtl"
REMOTE_LOG="$REMOTE_RTL/vlog_mac.log"

echo "Remote MAC sim"
echo "Host : $REMOTE_USER@$REMOTE_HOST"
echo "RTL  : $REMOTE_RTL"
echo

# Login shell so lab Questa/vlog is on PATH (module load / .bashrc).
ssh -t "$REMOTE_USER@$REMOTE_HOST" bash -lc "
set -euo pipefail
cd $REMOTE_RTL

if ! command -v vlog >/dev/null 2>&1; then
    echo 'ERROR: vlog not in PATH. Source your Questa setup in ~/.bashrc' >&2
    exit 1
fi

vlib work >/dev/null 2>&1 || true

# Package first, then MAC designs. Course TB files if you copied them into part1/.
FILES=(comm_pkg.sv part1/mac.sv part1/mac_pipe.sv)
if [[ -f part1/mac_tb.sv ]]; then
    FILES+=(part1/mac_tb.sv)
fi
if [[ -f part1/mac_tb.c ]]; then
    FILES+=(part1/mac_tb.c)
fi

echo '== vlog =='
vlog -64 -sv +acc \"\${FILES[@]}\" -l $REMOTE_LOG
echo
tail -n 5 $REMOTE_LOG
echo

if grep -q 'Errors: 0' $REMOTE_LOG; then
    echo 'COMPILE OK (Errors: 0)'
else
    echo 'COMPILE FAILED — see vlog_mac.log (last line is Errors: N)' >&2
    exit 1
fi

# Provided course flow, if you put simParams1 in part1/.
if [[ -x part1/simParams1 ]]; then
    echo
    echo '== simParams1 (WIDTH=8 ACCW=24 unpipelined, batch) =='
    (cd part1 && ./simParams1 8 24 0 0)
elif [[ -f part1/mac_tb.sv ]]; then
    echo
    echo '== vsim mac_tb =='
    vsim -64 -c mac_tb -sv_seed random -do 'run -all; quit' -l $REMOTE_RTL/vsim_mac.log
    tail -n 20 $REMOTE_RTL/vsim_mac.log
else
    echo
    echo 'No part1/mac_tb.sv or simParams1 on the server — compile check only.'
    echo 'Copy the course testbench into remote part1/ to run vsim from this script.'
fi
"

echo
echo "Fetching transcript..."
rsync -az \
    "$REMOTE_USER@$REMOTE_HOST:$REMOTE_LOG" \
    "$LOCAL_LOG_DIR/vlog.log" || true

if [[ -f "$LOCAL_LOG_DIR/vlog.log" ]]; then
    echo "Local copy: $LOCAL_LOG_DIR/vlog.log"
    grep -E 'Errors:|Error:' "$LOCAL_LOG_DIR/vlog.log" | tail -n 8 || true
fi
