#!/usr/bin/env bash
# vlog [DUT] — compile on CAD. Run link first so rtl/ and tb/ are already there.

set -euo pipefail
# shellcheck source=libaray/cad_common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/libaray/cad_common.sh"

usage() {
    cat <<'EOF'
vlog [DUT]

  Run link first. vlog does not sync rtl/ or tb/.
  [DUT] is a module name or a source path. rtl/param.sv is compiled first.

  -h, --help    this text
EOF
}

[[ "${1:-}" == -h || "${1:-}" == --help ]] && { usage; exit 0; }
[[ $# -gt 0 ]] || { usage >&2; exit 2; }
cad_vlog "$@"
