#!/usr/bin/env bash
# Host-master link of rtl/ and tb/ with lab40.
#   1) push host  -> remote  (host wins; --delete drops remote leftovers)
#   2) pull remote -> host   (--ignore-existing: never overwrite host files)
# Never copies tool-only files (work/, waves, transcripts, DC/Questa junk).
#   link

set -euo pipefail
# shellcheck source=cad_common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/cad_common.sh"

# extras[name] = extra rsync args (e.g. skip tb/README.md)
declare -A TREE_EXTRAS
TREE_EXTRAS[rtl]=""
TREE_EXTRAS[tb]="--exclude /README.md"

report_xfer() {
    local out="$1"
    local empty_msg="$2"
    echo "$out"
    if ! echo "$out" | grep -qE '[.](sv|c|vh|do|tcl)$'; then
        echo "$empty_msg"
    fi
}

sync_one() {
    local name="$1" mode="$2"
    local local_dir="$PROJECT_ROOT/$name"
    local remote="$REMOTE_USER@$REMOTE_HOST:~/$REMOTE_PROJECT_REL/$name/"
    # shellcheck disable=SC2206
    local extras=( ${TREE_EXTRAS[$name]} )
    local out

    mkdir -p "$local_dir"

    echo "-- $name/"
    if [[ "$mode" == push ]]; then
        out=$(rsync_project_ssh "$name" "${extras[@]}" --delete "$local_dir/" "$remote")
        report_xfer "$out" "(already up to date)"
    else
        out=$(rsync_project_ssh "$name" "${extras[@]}" --ignore-existing "$remote" "$local_dir/" || true)
        report_xfer "$out" "(no new files from lab40)"
    fi
    echo
}

echo "Link  host -> lab40  ~/$REMOTE_PROJECT_REL/{rtl,tb}  (host is master)"
echo "Host : $PROJECT_ROOT/{rtl,tb}/"
echo "Lab40: $REMOTE_USER@$REMOTE_HOST:~/$REMOTE_PROJECT_REL/{rtl,tb}/"
echo

echo "== push this computer -> lab40 =="
sync_one rtl push
sync_one tb push

echo "== pull lab40 -> this computer (host files kept) =="
sync_one rtl pull
sync_one tb pull

echo "Link complete."
