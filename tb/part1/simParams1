#!/usr/bin/bash

# script to generate the params.sv file based on the command line parameters, compile the code and testbench, and run simulation
# usage: ./simParams1 [WIDTH] [ACCW] [PIPELINED] [GUI]
#    where you will replace [WIDTH] [ACCW] and [PIPELINED] with the desired value of
#    those parameters
#      - WIDTH is the bitwidth of the MAC inputs and of the MAC output
#        (2 <= WIDTH < 32)
#      - ACCW is the bitwidth of the MAC's accumulator
#        (ACCW must be >= 2*WIDTH and <= 80)
#    if [GUI] is 0, the simulation will run in waveform mode. If [GUI] is 1, it will
#    run QuestaSim in GUI mode

# example: for WIDTH=8, ACCW=24, PIPELINED=0, simulating at the command line only, run:
#        ./simParams1 8 24 0 0

# If you want to run in GUI mode, you should run with & at the end, like
#        ./simParams1 8 24 0 1 &

# Compiles the course TB only (mac_tb.sv + mac_tb.c). Do not glob *.c — 
# mac_tb_mod.c defines the same DPI symbols and the linker will fail.
# RTL is ../../rtl/param_pkg.sv and ../../rtl/part1/*.sv.

if [ $# -ne 4 ]; then
    echo "ERROR: incorrect number of parameters given."
    echo "Usage: ./simParams1 [WIDTH] [ACCW] [PIPELINED] [GUI]"
    echo "See comments in simParams1 file for more information"
else
    ./genParams1 $1 $2 $3
    SEED=$(sed -n 's/^`define SEEDVAL //p' params.sv | tr -d '\r')
    [[ -n "$SEED" ]] || SEED=random
    echo "Using -sv_seed $SEED  (edit SEEDVAL in params.sv to reproduce)"
    rm -rf work
    vlib work
    SRCS="mac_tb.sv mac_tb.c ../../rtl/param_pkg.sv ../../rtl/part1/*.sv"
    vlog -64 +acc +incdir+. +incdir+../../rtl +incdir+../../rtl/part1 $SRCS || exit 1
    if [[ $4 -eq 0 ]]; then
        vsim -64 -sv_seed "$SEED" -c mac_tb -do "run -all; quit"
    else
        vsim -64 -sv_seed "$SEED" mac_tb
    fi
fi
