#!/usr/bin/bash

# Generate params.sv, optionally compile and simulate.
# usage: ./simParams1 [WIDTH] [ACCW] [PIPELINED] [GUI]
#    3 args: write params.sv only
#    4 args: write params.sv, compile, run vsim
#      - WIDTH is the bitwidth of the MAC inputs and of the MAC output
#        (2 <= WIDTH < 32)
#      - ACCW is the bitwidth of the MAC's accumulator
#        (ACCW must be >= 2*WIDTH and <= 80)
#    if [GUI] is 0, the simulation will run at the command line.
#    If [GUI] is 1, it will run QuestaSim in GUI mode.

# example: for WIDTH=8, ACCW=24, PIPELINED=0, write params.sv only:
#        ./simParams1 8 24 0
# command-line sim:
#        ./simParams1 8 24 0 0
# GUI (run with &):
#        ./simParams1 8 24 0 1 &

# Note that this will compile all .sv and .c files in your directory plus
# ../../rtl. If instead you only want to compile some of them, compile
# directly from the command line.

if [ $# -ne 3 ] && [ $# -ne 4 ]; then
    echo "ERROR: incorrect number of parameters given."
    echo "Usage: ./simParams1 [WIDTH] [ACCW] [PIPELINED] [GUI]"
    echo "  3 args: write params.sv   4 args: write, compile, simulate"
    echo "See comments in simParams1 file for more information"
    exit 1
fi

echo "\`define WIDTHVAL $1" > params.sv
echo "\`define ACCWVAL $2" >> params.sv
echo "\`define PIPELINEDVAL $3" >> params.sv
echo "Wrote params.sv (WIDTH=$1 ACCW=$2 PIPELINED=$3)"

if [ $# -eq 3 ]; then
    exit 0
fi

# TB lives in tb/part1/; design lives in rtl/
SRCS="*.sv ../../rtl/param_pkg.sv ../../rtl/part1/*.sv"
ls *.c > /dev/null 2>&1 && SRCS="$SRCS *.c"
vlog -64 +acc $SRCS || exit 1
if [[ $4 -eq 0 ]]; then
    vsim -64 -sv_seed random -c mac_tb -do "run -all; quit"
else
    vsim -64 -sv_seed random mac_tb
fi
