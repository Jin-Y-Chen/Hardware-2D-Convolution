#!/usr/bin/bash

# script to generate the params.sv file based on the command line parameters
# usage: ./genParams2 [WIDTH] [R] [C] [K] [TVALID_PROB] [STAGE]
#    where you will replace [WIDTH] [R] [C] [K] [TVALID_PROB] and [STAGE] with
#    the desired value of those parameters.
#    Remember that if TVALID_PROB = 0, the testbench will randomize it.
#    [STAGE] is 0, 1, 2, or 3, and selects how much of the specification the
#    testbench checks. See the Part 2 handout. Stage 3 is the complete test.
# example: for WIDTH=16, R=7, C=6, K=5 with random TVALID_PROB, running the
# complete test, run:
#      ./genParams2 16 7 6 5 0 3

if [ $# -ne 6 ]; then
    echo "ERROR: incorrect number of parameters given."
    echo "Usage: ./genParams2 [WIDTH] [R] [C] [K] [TVALID_PROB] [STAGE]"
    echo "See comments in genParams2 file for more information"
else
    echo "\`define WIDTHVAL $1" > params.sv
    echo "\`define RVAL $2" >> params.sv
    echo "\`define CVAL $3" >> params.sv
    echo "\`define KVAL $4" >> params.sv
    echo "\`define TVPR $( sed 's/^[.]/0./' <<< "$5" )" >> params.sv
    echo "\`define STAGEVAL $6" >> params.sv
fi
