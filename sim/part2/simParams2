#!/usr/bin/bash

# Compile input_mems and its testbench, then simulate.
# usage: ./simParams2 [WIDTH] [R] [C] [K] [TVALID_PROB] [STAGE] [GUI]
#    TVALID_PROB = 0 makes the testbench randomize AXIS_TVALID.
#    STAGE is 1, 2, or 3. Stage 3 is the complete test.
#    GUI 0 runs in the console. GUI 1 opens Questa.
# example:
#        ./simParams2 16 7 6 5 0 3 0
# GUI example (background it):
#        ./simParams2 16 7 6 5 0 3 1 &

if [ $# -ne 7 ]; then
    echo "ERROR: incorrect number of parameters given."
    echo "Usage: ./simParams2 [WIDTH] [R] [C] [K] [TVALID_PROB] [STAGE] [GUI]"
    exit 1
fi

# This script lives in sim/part2. The DUT and testbench are not in this directory.
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
cd "$HERE"

# Local params.sv (defines). Compiled below instead of rtl/param.sv.
bash "$HERE/genParams2" "$1" "$2" "$3" "$4" "$5" "$6" || exit 1

vlog -64 -sv +acc \
    "$HERE/params.sv" \
    "$ROOT/rtl/part2/input_mems.sv" \
    "$ROOT/tb/part2/input_mems_tb.sv" || exit 1

if [[ $7 -eq 0 ]]; then
    vsim -64 -sv_seed random -c input_mems_tb -do "run -all; quit"
else
    vsim -64 -sv_seed random input_mems_tb
fi
