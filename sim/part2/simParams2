#!/usr/bin/bash

# script to generate the params.sv file based on the command line parameters,
# compile the code and testbench, and run simulation.
# usage: ./simParams2 [WIDTH] [R] [C] [K] [TVALID_PROB] [STAGE] [GUI]
#    where you will replace [WIDTH] [R] [C] [K] [TVALID_PROB] and [STAGE] with
#    the desired value of those parameters.
#    Remember that if TVALID_PROB = 0, the testbench will randomize it.

#    [STAGE] is 0, 1, 2, or 3, and selects how much of the specification the
#    testbench checks. See the Part 2 handout. Stage 3 is the complete test.

#    if [GUI] is 0, the simulation will run in waveform mode. If [GUI] is 1, it will
#    run QuestaSim in GUI mode
# example: for WIDTH=16, R=7, C=6, K=5 with random TVALID_PROB, running the
# complete test at the command line only, run:
#        ./simParams2 16 7 6 5 0 3 0

# If you want to run in GUI mode, you should run with & at the end, like
#        ./simParams2 16 7 6 5 0 3 1 &

# Compiles the part2 sources in rtl/ and tb/.

if [ $# -ne 7 ]; then
    echo "ERROR: incorrect number of parameters given."
    echo "Usage: ./simParams2 [WIDTH] [R] [C] [K] [TVALID_PROB] [STAGE] [GUI]"
    echo "See comments in simParams2 file for more information"
else
    ./genParams2 $1 $2 $3 $4 $5 $6
    vlog -64 +acc +incdir+. \
        ../../rtl/part2/input_mems.sv \
        ../../tb/part2/input_mems_tb.sv
    if [[ $7 -eq 0 ]]; then
        vsim -64 -sv_seed random -c input_mems_tb -do "run -all; quit"
    else
        vsim -64 -sv_seed random input_mems_tb
    fi
fi
