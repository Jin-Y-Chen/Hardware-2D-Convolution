#!/usr/bin/bash

# Write constraint/param/params.sv from WIDTH ACCW PIPELINED [SEED]
# usage: ./genParams1 [WIDTH] [ACCW] [PIPELINED] [SEED]
#    SEED is optional (default: keep SEEDVAL in constraint/param/params.sv, or random)
#    Paste a failing run's Sv_Seed here to reproduce, e.g. 1896683400
#      - WIDTH is the bitwidth of the MAC inputs and of the MAC output
#        (2 <= WIDTH < 32)
#      - ACCW is the bitwidth of the MAC's accumulator
#        (ACCW must be >= 2*WIDTH and <= 80)

# Run from sim/part1. Writes ../../constraint/param/params.sv
# example: ./genParams1 8 24 0
# reproduce a seed: ./genParams1 8 24 0 1896683400

if [ $# -ne 3 ] && [ $# -ne 4 ]; then
    echo "ERROR: incorrect number of parameters given."
    echo "Usage: ./genParams1 [WIDTH] [ACCW] [PIPELINED] [SEED]"
    echo "See comments in genParams1 file for more information"
    exit 1
fi

DIR="$(cd "$(dirname "$0")" && pwd)"
PARAM="$DIR/../../constraint/param/params.sv"
mkdir -p "$(dirname "$PARAM")"

SEED="random"
if [ -f "$PARAM" ]; then
    OLD=$(sed -n 's/^`define SEEDVAL //p' "$PARAM" | tr -d '\r')
    [[ -n "$OLD" ]] && SEED="$OLD"
fi
[[ $# -eq 4 ]] && SEED="$4"

echo "\`define WIDTHVAL $1" > "$PARAM"
echo "\`define ACCWVAL $2" >> "$PARAM"
echo "\`define PIPELINEDVAL $3" >> "$PARAM"
echo "\`define SEEDVAL $SEED" >> "$PARAM"
echo "Wrote constraint/param/params.sv (WIDTH=$1 ACCW=$2 PIPELINED=$3 SEED=$SEED)"
