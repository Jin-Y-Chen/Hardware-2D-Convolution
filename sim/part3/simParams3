#!/usr/bin/bash

# Generate params.sv, compile Conv and Conv_tb, and simulate with xrun.
# usage: ./simParams3 [WIDTH] [R] [C] [K] [TVALID_PROB] [TREADY_PROB] [GUI]
#    TVALID_PROB or TREADY_PROB = 0 makes the testbench randomize that signal.
#    GUI 0 runs in the console. GUI 1 opens Xcelium.
# example:
#        ./simParams3 12 8 8 5 0 0 0
# GUI example (background it):
#        ./simParams3 12 8 8 5 0 0 1 &

if [ $# -ne 7 ]; then
    echo "ERROR: incorrect number of parameters given."
    echo "Usage: ./simParams3 [WIDTH] [R] [C] [K] [TVALID_PROB] [TREADY_PROB] [GUI]"
    echo "See comments in simParams3 file for more information"
    exit 1
fi

HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
cd "$HERE"

bash "$HERE/genParams3" "$1" "$2" "$3" "$4" "$5" "$6" || exit 1
# Conv and mac_pipe read package param. The testbench includes the defines file.
cat > "$HERE/param_pkg.sv" << EOF
package param;
    localparam int WIDTH = $1;
    localparam int R = $2;
    localparam int C = $3;
    localparam int K = $4;
    localparam int ACCW = \$clog2(K*K*(128'd1 << (2*WIDTH-2)) + (1 << (WIDTH-1))) + 1;
endpackage
EOF

# -64bit is Questa -64. -access +r is +acc. -svseed is -sv_seed.
# One xrun command compiles and runs.
cmd=(xrun -64bit -access +r -svseed 507 -clean -top Conv_tb
    -incdir "$HERE"
    "$HERE/param_pkg.sv"
    "$ROOT/rtl/part3/fifo_out.sv"
    "$ROOT/rtl/part3/control.sv"
    "$ROOT/rtl/part3/input_mems.sv"
    "$ROOT/rtl/part3/mac_pipe.sv"
    "$ROOT/rtl/part3/Conv.sv"
    "$ROOT/tb/part3/Conv_tb.sv"
    "$ROOT/tb/part3/test_helper.c")
if [[ $7 -eq 1 ]]; then
    cmd+=(-gui)
fi
"${cmd[@]}"
