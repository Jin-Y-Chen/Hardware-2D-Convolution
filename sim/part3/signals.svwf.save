	{[format {Conv_tb.dut.FSM_ctrl.X_next_addr[6:0]}]}
	} ]]
waveform format $id -radix %d
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.mac_unit.init_value[9:0]}]}
	} ]]
waveform format $id -radix %d
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.init_acc}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.FSM_ctrl.valid_read}]}
	} ]]
