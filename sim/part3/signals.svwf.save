set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.FSM_ctrl.reset_W_addr}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.FSM_ctrl.delta_R[10:0]}]}
	} ]]
waveform format $id -radix %d
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.FSM_ctrl.next_R_ptr[8:0]}]}
	} ]]
waveform format $id -radix %d
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.FSM_ctrl.this_slice[6:0]}]}
	} ]]
waveform format $id -radix %d
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.FSM_ctrl.next_slice[6:0]}]}
	} ]]
waveform format $id -radix %d
