	{[format {Conv_tb.dut.axis_in.state[1:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.B[9:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.Q[6:0]}]}
	} ]]
waveform format $id -radix %d
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.S[2:0]}]}
	} ]]
waveform format $id -radix %d
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.reset}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.clk}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.input_loaded}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.compute_finished}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.FSM_ctrl.stall_bar}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.FSM_ctrl.en}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.FSM_ctrl.w_ptr.inc_en}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.FSM_ctrl.state[1:0]}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.FSM_ctrl.next_state[1:0]}]}
	} ]]
set id [waveform add -signals [subst  {
