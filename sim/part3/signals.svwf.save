	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.OUTPUT_TDATA[9:0]}]}
	} ]]
waveform format $id -radix %d
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.OUTPUT_TREADY}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.dut.OUTPUT_TVALID}]}
	} ]]
set id [waveform add -signals [subst  {
	{[format {Conv_tb.which_element_out[31:0]}]}
	} ]]
waveform format $id -radix %d
set id [waveform add -signals [subst  {
	{[format {Conv_tb.errors}]}
	} ]]

waveform xview limits 699453ns 699604ns
